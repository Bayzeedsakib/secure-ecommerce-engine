# Copy to .env and fill in the values marked "required".

# PostgreSQL connection (matches docker-compose.yml in the project root).
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5433/ecommerce?schema=public"

# Required. Secret for signing login tokens, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Required. Stripe test-mode secret key: Stripe Dashboard -> Developers -> API keys.
# Only sk_test_ keys are accepted, so real cards can never be charged.
STRIPE_SECRET_KEY=sk_test_replace_me

# Optional. Webhook signing secret (whsec_...) printed by `stripe listen`.
# Without it, payments are confirmed when the customer returns to the site.
STRIPE_WEBHOOK_SECRET=

CURRENCY=usd
# How long a Stripe checkout page stays payable (30-1440 minutes).
CHECKOUT_EXPIRES_MINUTES=30

PORT=5000
# Frontend URL Stripe redirects back to after payment.
CLIENT_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Requests per IP per 15 minutes (all routes / login + register).
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# Number of reverse proxies in front of the API (for correct client IPs).
TRUST_PROXY=0

# Admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@shop.test
SEED_ADMIN_PASSWORD=Admin@12345
